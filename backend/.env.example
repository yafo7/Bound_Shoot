HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/bound-shoot.sqlite
# Generate at least 32 random bytes. Never commit real keys.
ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
PUBLIC_GAME_HOST=127.0.0.1
GAME_PORT_START=7777
MAX_MATCHES=2
# manual: launch generated runtime/<matchId>.json using tools/start-server.ps1
# managed: launch GAME_SERVER_PATH automatically
SERVER_MODE=manual
GAME_SERVER_PATH=
RUNTIME_DIR=runtime
# Public deployment: set https/wss reverse proxy and HOST=127.0.0.1
