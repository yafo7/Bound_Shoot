HOST=127.0.0.1
PORT=3000
NODE_ENV=production
ACCESS_SECRET=replace-with-at-least-32-random-bytes
DATABASE_PATH=/var/lib/bound-shoot/game.sqlite
RUNTIME_DIR=/var/lib/bound-shoot/runtime
SERVER_MODE=managed
GAME_SERVER_PATH=/opt/bound-shoot/server/BoundShootServer.x86_64
GAME_CONFIG_PATH=/opt/bound-shoot/unity-client/Assets/BoundShoot/Resources/GameConfig.json
PUBLIC_GAME_HOST=replace-with-public-ip-or-dns
GAME_PORT_START=7777
MAX_MATCHES=2
